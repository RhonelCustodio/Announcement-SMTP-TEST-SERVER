{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "firestore.rules.open", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
