rules_version = "2";

// ── Announcement board: public read, admin write ──────────────────────────
// With the rules below ANYONE can read the board (what visitors need) but only
// a signed-in user whose uid is listed in /allowedAdmins/{uid} may write.
// That is what actually protects your data — the PIN in site-config.js is only
// UI sugar and can be bypassed by anyone who opens devtools.
//
// If you want zero-setup writes while testing, replace the three create/update
// lines with `allow write: if true;` — but ONLY while developing, then put the
// real rules back and enable Hosting + Auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedAdmins/$(request.auth.uid));
    }

    function validAnnouncement() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.body  is string && d.body.size()  <= 4000
          && d.category in ['general','event','urgent','deadline','lostfound','closing']
          && d.priority in ['low','normal','high','urgent']
          && d.pinned is bool
          && (!('imageUrl' in d.keys()) || d.imageUrl matches '^https?://.*')
          && (!('link' in d.keys()) || d.link matches '^https?://.*')
          && (!('author' in d.keys()) || d.author.size() <= 60);
    }

    match /announcements/{id} {
      allow read:   if true;                              // public board
      allow create: if isAdmin() && validAnnouncement();
      allow update: if isAdmin() && (request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['title','body','category','priority','author','pinned',
                               'imageUrl','link','eventDate','expiresAt','updatedAt']));
      allow delete: if isAdmin();

      // 300 notices per read is the app's hard limit — keep the board cheap.
      allow list:   if true && request.query.limit <= 300;
    }

    // Doc with uid as its id = that user is an admin. Create it by hand in the
    // Firebase console after you sign in once.
    match /allowedAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // you only ever create/delete from the console
    }
  }
}
